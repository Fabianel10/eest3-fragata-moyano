# Variables de entorno para Netlify Functions (backend de contacto).
# Copiar los valores reales en Netlify > Site configuration > Environment variables.
# NUNCA versionar este archivo con claves reales.

# Habilita la recepción de consultas en Supabase.
CONTACT_ENABLED=false

# Origen exacto del sitio publicado. Debe coincidir con el header Origin.
URL=https://eest3sf.netlify.app

# Proyecto Supabase y clave de servidor. La service_role NUNCA va al frontend.
SUPABASE_URL=https://dzkcpsfmubwwguixtruu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_LndMgFwkYmHV9xUQqb1aOQ_kXPBYgFR

# Secreto de al menos 64 caracteres para anonimizar la IP en el límite de envíos.
CONTACT_HASH_SECRET=

# Correo transaccional de la cola persistente.
# EMAIL_ENABLED=true activa el procesamiento; sin esto la cola queda pendiente.
EMAIL_ENABLED=false
EMAIL_PROVIDER=brevo
EMAIL_FROM=no-reply@eest3sf.netlify.app
EMAIL_FROM_NAME=EEST N°3 Fragata Moyano
BREVO_API_KEY=
# Alternativa: EMAIL_PROVIDER=resend y RESEND_API_KEY=
RESEND_API_KEY=
# Secreto para disparar manualmente /netlify/functions/procesar-correo-manual.
EMAIL_QUEUE_SECRET=

# Solo para aplicar migraciones desde una terminal autorizada. Nunca commitear.
# Postgres pooled: postgresql://postgres.<ref>:<password>@aws-0-us-west-2.pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=
# Opcional: host del pooler si el proyecto no está en us-west-2.
SUPABASE_DB_POOLER_HOST=
